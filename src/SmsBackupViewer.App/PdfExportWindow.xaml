<Window x:Class="SmsBackupViewer.App.PdfExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SmsBackupViewer.App"
        xmlns:vm="clr-namespace:SmsBackupViewer.App.ViewModels"
        Title="Export to PDF" Height="820" Width="1180"
        MinHeight="640" MinWidth="960"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}"
        FontFamily="{StaticResource BodyFont}">

    <Window.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <local:InverseBoolConverter x:Key="NotBusy"/>
        <local:StringToVisibilityConverter x:Key="TextToVis"/>

        <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource SubHeading}">
            <Setter Property="Margin" Value="0,14,0,6"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Stepper" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="62"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource HeaderFill}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="18,13">
            <StackPanel>
                <TextBlock Text="Export to PDF" Style="{StaticResource Heading}"/>
                <TextBlock Text="Conversations print as message bubbles with photos inline. Video, audio and other files cannot be displayed in a PDF, so they are copied alongside it and referenced by name."
                           Style="{StaticResource Muted}" Margin="0,3,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="470" MinWidth="380"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <!-- Options -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="18,4,14,10">
                <StackPanel IsEnabled="{Binding IsBusy, Converter={StaticResource NotBusy}}">

                    <TextBlock Text="Output" Style="{StaticResource Section}" Margin="0,8,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Content="Browse…" Style="{StaticResource SecondaryButton}"
                                Command="{Binding BrowseOutputCommand}"/>
                    </Grid>
                    <CheckBox Content="One combined PDF instead of one per conversation"
                              IsChecked="{Binding SingleDocument}" Margin="0,8,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                Visibility="{Binding SingleDocument, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Title" Style="{StaticResource FieldLabel}"/>
                        <TextBox Width="300" Text="{Binding DocumentTitle, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <TextBlock Text="Cover page" Style="{StaticResource Section}"/>
                    <CheckBox Content="Include a cover page" IsChecked="{Binding IncludeCoverPage}"/>
                    <StackPanel Margin="18,4,0,0"
                                Visibility="{Binding IncludeCoverPage, Converter={StaticResource BoolToVis}}">
                        <CheckBox Content="List every conversation" IsChecked="{Binding ListConversationsOnCover}"/>
                        <CheckBox Content="List source backups and their SHA-256 hashes"
                                  IsChecked="{Binding ListSourcesOnCover}" Margin="0,4,0,0"/>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Subtitle" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="0" Grid.Column="1"
                                     Text="{Binding Subtitle, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="1" Text="Reference" Style="{StaticResource FieldLabel}" Margin="0,6,8,0"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,6,0,0"
                                     Text="{Binding Reference, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="2" Text="Prepared by" Style="{StaticResource FieldLabel}" Margin="0,6,8,0"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Margin="0,6,0,0"
                                     Text="{Binding PreparedBy, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="3" Text="Prepared for" Style="{StaticResource FieldLabel}" Margin="0,6,8,0"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Margin="0,6,0,0"
                                     Text="{Binding PreparedFor, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="4" Text="Notes" Style="{StaticResource FieldLabel}" Margin="0,6,8,0"
                                       VerticalAlignment="Top"/>
                            <TextBox Grid.Row="4" Grid.Column="1" Margin="0,6,0,0" Height="52"
                                     AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Top"
                                     Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </StackPanel>

                    <TextBlock Text="What to include" Style="{StaticResource Section}"/>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox Content="SMS" IsChecked="{Binding IncludeSms}"/>
                        <CheckBox Content="MMS" IsChecked="{Binding IncludeMms}"/>
                        <CheckBox Content="Calls" IsChecked="{Binding IncludeCalls}"/>
                    </StackPanel>
                    <CheckBox Content="Delivery receipts" IsChecked="{Binding IncludeDeliveryReceipts}"
                              Margin="0,6,0,0"
                              ToolTip="MMS records of type 134, which carry no readable message"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="Between" Style="{StaticResource FieldLabel}"/>
                        <DatePicker SelectedDate="{Binding StartDate}" Width="122"/>
                        <TextBlock Text="and" Style="{StaticResource FieldLabel}" Margin="8,0"/>
                        <DatePicker SelectedDate="{Binding EndDate}" Width="122"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="Order" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Width="140" ItemsSource="{Binding SortOrders}" SelectedItem="{Binding SortOrder}"/>
                    </StackPanel>
                    <CheckBox Content="Number each record, so a message can be cited"
                              IsChecked="{Binding NumberRecords}" Margin="0,8,0,0"/>
                    <CheckBox Content="Show the raw type code beside the direction"
                              IsChecked="{Binding ShowRawTypeCodes}" Margin="0,4,0,0"/>
                    <CheckBox Content="Show the address under each sender's name"
                              IsChecked="{Binding ShowAddresses}" Margin="0,4,0,0"/>
                    <CheckBox Content="Start each conversation on a new page"
                              IsChecked="{Binding PageBreakBetweenConversations}" Margin="0,4,0,0"/>

                    <TextBlock Text="Page and type" Style="{StaticResource Section}"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Paper" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Width="96" ItemsSource="{Binding PaperSizes}" SelectedItem="{Binding PaperSize}"/>
                        <ComboBox Width="112" Margin="8,0,0,0" ItemsSource="{Binding Orientations}"
                                  SelectedItem="{Binding Orientation}"/>
                        <TextBlock Text="Margin" Style="{StaticResource FieldLabel}" Margin="12,0,8,0"/>
                        <TextBox Style="{StaticResource Stepper}" Text="{Binding Margin}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="Text size" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource Stepper}" Text="{Binding FontSize}"/>
                        <TextBlock Text="Bubble width" Style="{StaticResource FieldLabel}" Margin="12,0,8,0"/>
                        <TextBox Style="{StaticResource Stepper}" Text="{Binding BubbleWidth}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="Dates" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Width="250" ItemsSource="{Binding DateStyles}" SelectedItem="{Binding DateStyle}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="Time zone" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Width="300" ItemsSource="{Binding TimeZones}" SelectedItem="{Binding TimeZone}"
                                  DisplayMemberPath="DisplayName"
                                  ToolTip="Every timestamp is rendered in this zone and the cover page says so"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <CheckBox Content="Page numbers" IsChecked="{Binding ShowPageNumbers}"/>
                        <CheckBox Content="Running header" IsChecked="{Binding ShowRunningHeader}"/>
                    </StackPanel>

                    <TextBlock Text="Images and attachments" Style="{StaticResource Section}"/>
                    <CheckBox Content="Show photos inline" IsChecked="{Binding InlineImages}"/>
                    <StackPanel Orientation="Horizontal" Margin="18,6,0,0"
                                Visibility="{Binding InlineImages, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Max height" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource Stepper}" Text="{Binding MaxImageHeight}"/>
                        <TextBlock Text="DPI" Style="{StaticResource FieldLabel}" Margin="12,0,8,0"/>
                        <TextBox Style="{StaticResource Stepper}" Text="{Binding ImageDpi}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="18,6,0,0"
                                Visibility="{Binding InlineImages, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Quality" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Width="200" ItemsSource="{Binding ImageQualities}" SelectedItem="{Binding ImageQuality}"/>
                    </StackPanel>

                    <CheckBox Content="Copy attachments beside the PDF" IsChecked="{Binding CopyAttachments}"
                              Margin="0,10,0,0"
                              ToolTip="Required for video and audio references to point at real files"/>
                    <StackPanel Margin="18,6,0,0"
                                Visibility="{Binding CopyAttachments, Converter={StaticResource BoolToVis}}">
                        <CheckBox Content="Include photos in that folder too" IsChecked="{Binding CopyImagesToo}"/>
                        <CheckBox Content="Write attachments.csv listing them"
                                  IsChecked="{Binding WriteAttachmentIndex}" Margin="0,4,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="Folder name" Style="{StaticResource FieldLabel}"/>
                            <TextBox Width="160"
                                     Text="{Binding AttachmentsFolderName, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </StackPanel>

                    <CheckBox Content="Compress the finished PDF" IsChecked="{Binding CompressDocument}"
                              Margin="0,10,0,0"/>

                    <Button Content="Reset appearance to defaults" Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Left" Margin="0,14,0,10"
                            Command="{Binding ResetAppearanceCommand}"/>
                </StackPanel>
            </ScrollViewer>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="{StaticResource BorderBrush}"/>

            <!-- Conversations -->
            <Grid Grid.Column="2" Margin="14,12,18,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Conversations to export" Style="{StaticResource SubHeading}"
                               VerticalAlignment="Center"/>
                    <Button Content="All" Style="{StaticResource SecondaryButton}" Margin="12,0,0,0"
                            Command="{Binding SelectAllCommand}"/>
                    <Button Content="None" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0"
                            Command="{Binding SelectNoneCommand}"/>
                </StackPanel>

                <Border Grid.Row="1" Padding="10,8" Background="#fff6e5" Margin="0,0,0,8"
                        BorderBrush="#e6ae48" BorderThickness="1" CornerRadius="3"
                        Visibility="{Binding WarningText, Converter={StaticResource TextToVis}}">
                    <TextBlock Text="{Binding WarningText}" TextWrapping="Wrap" FontSize="12"/>
                </Border>

                <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        Margin="0,0,0,12">
                    <ListBox ItemsSource="{Binding Conversations}" BorderThickness="0"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="10,7"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ConversationChoice}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" Margin="0,0,10,0"
                                              VerticalAlignment="Center" Checked="OnSelectionChanged"
                                              Unchecked="OnSelectionChanged"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding AddressText}" Style="{StaticResource Muted}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding RangeText}" Style="{StaticResource Muted}"
                                               VerticalAlignment="Center" Margin="10,0"/>
                                    <TextBlock Grid.Column="3" Text="{Binding CountsText}" FontSize="12"
                                               VerticalAlignment="Center" MinWidth="160" TextAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>
        </Grid>

        <!-- Progress and actions -->
        <Border Grid.Row="2" Background="{StaticResource HeaderFill}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="18,12">
            <StackPanel>
                <ProgressBar Value="{Binding Progress}" Maximum="100" Margin="0,0,0,8"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding ResultText}" Style="{StaticResource Muted}" Margin="0,6,0,0"
                           TextWrapping="Wrap"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Content="Open folder" Style="{StaticResource SecondaryButton}"
                            Command="{Binding OpenOutputFolderCommand}" Margin="0,0,8,0"
                            Visibility="{Binding HasFinished, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="Cancel" Style="{StaticResource SecondaryButton}"
                            Command="{Binding CancelCommand}" Margin="0,0,8,0"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="Close" Style="{StaticResource SecondaryButton}" Click="OnClose"
                            Margin="0,0,8,0"/>
                    <Button Content="Export PDF" Command="{Binding ExportCommand}" MinWidth="120"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
